# Ribix IDE — Environment Variable Reference
# Copy this file to .env.local (never commit .env.local).
# All variables are optional unless marked REQUIRED.

# ── Error monitoring ───────────────────────────────────────────────────────────
# Sentry DSN for error reporting in production.
# Set this in your production environment secrets (e.g. GitHub Actions secrets).
# Leave blank to disable Sentry (safe for local development).
SENTRY_DSN=

# ── Backend API ────────────────────────────────────────────────────────────────
# Base URL for the Ribix backend API (used by cloudSync, findings, telemetry).
# Defaults to the production endpoint when unset.
RIBIX_API_URL=https://api.ribix.dev

# ── Web IDE (Vite) ─────────────────────────────────────────────────────────────
# Exposed to the browser via import.meta.env.VITE_*

# Base URL for the Ribix backend API (web-ide Vite app).
VITE_API_BASE_URL=https://api.ribix.dev

# Base path for web-ide API routes (defaults to /web-ide).
VITE_WEB_IDE_API_BASE_URL=/web-ide

# WebSocket URL for the real-time collaboration server.
# Defaults to a path-relative URL derived from the current host when unset.
VITE_COLLABORATION_WS_URL=

# ── Web IDE collaboration WebSocket server ─────────────────────────────────────
# Port the collaboration WebSocket server listens on (default: 1234).
WS_PORT=1234

# ── OAuth / Authentication ─────────────────────────────────────────────────────
# GitHub OAuth client ID used for authentication flows.
# Register an OAuth app at https://github.com/settings/developers.
GITHUB_OAUTH_CLIENT_ID=

# GitHub OAuth client secret — NEVER commit the real value.
GITHUB_OAUTH_CLIENT_SECRET=

# ── Update checks ──────────────────────────────────────────────────────────────
# URL polled for IDE update information (web-ide update store).
NEXT_PUBLIC_UPDATE_URL=https://api.ribix.dev/updates/check
